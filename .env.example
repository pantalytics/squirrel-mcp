# Squirrel MCP Server -- configuration template.
# Copy this file to .env and fill in your own values. NEVER commit .env.
#
#   cp .env.example .env
#
# Squirrel runs locally and talks straight to your mail provider over TLS.
# No mail content is ever sent to a third party.

# ============================================================
# Mailbox
# ============================================================

# Backend. "imap" = any IMAP/SMTP mailbox (the only one for now). Later, API
# backends "gmail" / "outlook" plug in here; the tools stay the same.
# SQUIRREL_MAIL_PROVIDER=imap

# Your mailbox login -- usually your full email address plus your account
# password. Some providers want an app-specific password instead; check theirs.
SQUIRREL_MAIL_EMAIL=you@yourdomain.eu
SQUIRREL_MAIL_PASSWORD=your-account-password

# Only set this if your login username differs from your email address (rare).
# Defaults to SQUIRREL_MAIL_EMAIL.
# SQUIRREL_MAIL_USERNAME=you

# ============================================================
# Server locations (required -- your mail provider publishes these)
# ============================================================
# Look up your provider's IMAP/SMTP settings; Squirrel never guesses them.
# Ports below are the usual implicit-TLS ones, so you often only set the hosts.

# Incoming mail (IMAP). 993 for SSL, 143 for STARTTLS.
SQUIRREL_IMAP_HOST=imap.yourprovider.eu
# SQUIRREL_IMAP_PORT=993

# Outgoing mail (SMTP). 465 for SSL, 587 for STARTTLS.
SQUIRREL_SMTP_HOST=smtp.yourprovider.eu
# SQUIRREL_SMTP_PORT=465

# Transport security: ssl (default, implicit TLS) | starttls | plain.
# "plain" is for a trusted local test server only.
# SQUIRREL_IMAP_SECURITY=ssl
# SQUIRREL_SMTP_SECURITY=ssl
# Verify TLS certificates (default true). Only set false for a local test
# server with a self-signed certificate.
# SQUIRREL_TLS_VERIFY=true

# ============================================================
# Contacts (CardDAV) + Calendar (CalDAV) -- the other two pillars
# ============================================================
# Both are off unless you set a URL; your provider publishes these too (often
# one DAV host for both). They reuse the SAME login and password as mail.
# SQUIRREL_CARDDAV_URL=https://dav.yourprovider.eu
# SQUIRREL_CALDAV_URL=https://dav.yourprovider.eu

# ============================================================
# MCP transport (optional)
# ============================================================

# stdio (default, for Claude Desktop / Claude Code) or streamable-http.
# SQUIRREL_MCP_TRANSPORT=stdio
# SQUIRREL_MCP_HOST=localhost
# SQUIRREL_MCP_PORT=8000

# ============================================================
# Behaviour (optional)
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SQUIRREL_MCP_LOG_LEVEL=INFO

# Pagination defaults for mail_search.
# SQUIRREL_MCP_DEFAULT_LIMIT=25
# SQUIRREL_MCP_MAX_LIMIT=100

# Body length (chars) returned by mail_read before it asks you to page with
# mail_read_chunk. Keeps large messages out of a single dump.
# SQUIRREL_MCP_MAX_BODY_CHARS=20000
